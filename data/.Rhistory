?dt
#####
# Set parameters
df = 3           # Degrees of freedom
mean = 3         # Mean
sd = 0.5         # Standard deviation
# Create a sequence of values for the x-axis
x <- seq(-10, 10, length.out = 500)
# Calculate the PDF (density) of the t-distribution
pdf_values <- dt((x - mean) / sd, df = df)
# Plot the PDF
plot(x, pdf_values, type = "l", col = "blue",
main = "Probability Density Function (PDF)",
xlab = "x", ylab = "Density")
# Plot the CDF
plot(x, cdf_values, type = "l", col = "red",
main = "Cumulative Density Function (CDF)",
xlab = "x", ylab = "Cumulative Probability")
# Calculate the CDF (cumulative density) of the t-distribution
cdf_values <- pt((x - mean) / sd, df = df)
# Plot the CDF
plot(x, cdf_values, type = "l", col = "red",
main = "Cumulative Density Function (CDF)",
xlab = "x", ylab = "Cumulative Probability")
