identify_step <- function(force_data) {
df <- data.frame()
for (i in 2:length(force_data)) {
slope <- force_data[i]-force_data[i-1]
df <- rbind(df,slope)
}
colnames(df) <- c("deriv")
threshold = 0.01
idx = which(abs(df$deriv)<threshold)
idStep<-data.frame()
for (i in 2:length(idx)) {
if(idx[2]-idx[1]!=1){
idStep <- rbind(idStep,idx[i])
}
}
return(idStep)
}
